# ---------- Basics ----------
PORT=3000
# When using a tunnel (ngrok / cloudflared), set this to its https URL, e.g. https://xxxx.ngrok-free.app
# WhatsApp needs a public URL to download the invoice PDF
BASE_URL=http://localhost:3000

# ---------- AI: RunPod (recommended) ----------
# Create a vLLM endpoint on RunPod Serverless and fill in these three to use RunPod automatically
RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=
# Must match the Hugging Face model name you deployed on RunPod exactly
RUNPOD_MODEL=Qwen/Qwen2.5-7B-Instruct
# Turn on if your vLLM supports JSON mode (works without it too)
RUNPOD_JSON_MODE=false
# If the model takes longer than this (milliseconds), fall back to keyword rules
AI_TIMEOUT_MS=25000

# ---------- AI: other options (leave empty = keyword rules, the demo still works) ----------
# runpod | openai | anthropic | none (empty = pick automatically from whichever key is set)
AI_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Any OpenAI-compatible service works here
OPENAI_BASE_URL=https://api.openai.com/v1
# Voice-to-text currently only uses OpenAI
OPENAI_TRANSCRIBE_MODEL=whisper-1
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5

# ---------- WhatsApp Cloud API (leave empty = web simulator only) ----------
# From Meta for Developers → your app → WhatsApp → API Setup
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Any string you choose; type the same string in the Meta webhook settings
WHATSAPP_VERIFY_TOKEN=orderlah-dev
# App Secret (optional; when set, webhook signatures are checked)
WHATSAPP_APP_SECRET=
# Graph API version, check the Meta docs for the latest
WHATSAPP_GRAPH_VERSION=v23.0
# Payment reminders outside the 24-hour window need an approved template (optional)
WHATSAPP_REMINDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANG=en

# ---------- Real phones for the team (digits only, country code, no +) ----------
# Order approval cards and follow-up drafts go to OWNER_PHONE on real WhatsApp.
# Empty = keep the fictional demo numbers from data/seed.json
OWNER_PHONE=
SUPERVISOR_PHONE=
STAFF_PHONE=
